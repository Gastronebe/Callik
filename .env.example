# Callík - Environment Variables Example
# Web: www.callik.fun
# Provozovatel: Pavlína Šteiglová (info@callik.fun)

# Supabase Configuration
# Get these values from your Supabase project dashboard
# Dashboard: https://app.supabase.com/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Instructions:
# 1. Copy this file to js/config.js
# 2. Replace the placeholder values above with your actual Supabase credentials
# 3. In config.js, update the SUPABASE_URL and SUPABASE_ANON_KEY constants
#
# Example in config.js:
# const CONFIG = {
#   ...
#   SUPABASE_URL: 'https://abcdefgh.supabase.co',
#   SUPABASE_ANON_KEY: 'eyJhbGc...',
#   ...
# };
